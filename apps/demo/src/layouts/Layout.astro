---
interface Props {
  canonicalUrl?: string;
  description?: string;
  imageUrl?: string;
  title?: string;
}

import '../styles/global.css';

const siteUrl = Astro.site ?? new URL('https://astro-grab.nickradford.dev');
const defaultTitle = 'astro-grab - Visual element targeting for Astro';
const defaultDescription = [
  'Select any element in your Astro site and copy the exact component',
  'context for AI coding agents.',
].join(' ');
const defaultImageUrl = new URL('/og-image.png', siteUrl).toString();

const {
  canonicalUrl,
  description = defaultDescription,
  imageUrl = defaultImageUrl,
  title = defaultTitle,
} = Astro.props;

const canonicalHref =
  canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).toString();
const websiteId = new URL('/', siteUrl).toString();
const webpageId = `${canonicalHref}#webpage`;
const softwareId = `${websiteId}#software`;
const imageAlt = 'astro-grab visual element targeting for Astro sites';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@id': `${websiteId}#website`,
      '@type': 'WebSite',
      name: 'astro-grab',
      url: websiteId,
      sameAs: [
        'https://github.com/nickradford/astro-grab',
        'https://www.npmjs.com/package/@givebest/astro-grab',
      ],
    },
    {
      '@id': webpageId,
      '@type': 'WebPage',
      description,
      image: imageUrl,
      isPartOf: {
        '@id': `${websiteId}#website`,
      },
      name: title,
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: imageUrl,
      },
      url: canonicalHref,
    },
    {
      '@id': softwareId,
      '@type': 'SoftwareSourceCode',
      codeRepository: 'https://github.com/nickradford/astro-grab',
      creator: {
        '@type': 'Person',
        name: 'Nick Radford',
      },
      description,
      license: 'https://github.com/nickradford/astro-grab/blob/main/LICENSE',
      name: 'astro-grab',
      programmingLanguage: 'TypeScript',
      runtimePlatform: 'Astro',
      url: websiteId,
    },
  ],
};
const jsonLdString = JSON.stringify(jsonLd);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/astro-grab-favicon-512.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="astro-grab" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script type="application/ld+json" set:html={jsonLdString} />

    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css"
    />
    <link
      rel="stylesheet"
      type="text/css"
      href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/fill/style.css"
    />
  </head>
  <body class="min-h-screen bg-black font-mono leading-relaxed text-white">
    <slot />
    <script is:inline>
      function beforeSendHandler(type, payload) {
        if (payload.hostname !== "astro-grab.nickradford.dev") {
          console.log(type, payload);
          return false;
        }
        return payload;
      }
    </script>
    <script
      defer
      is:inline
      src="https://st.nickradford.dev/script.js"
      data-website-id="a105b203-64dc-4fd8-be7b-319fa279bf49"
      data-before-send="beforeSendHandler"></script>
  </body>
</html>
